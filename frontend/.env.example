# URL of the Laravel API (no trailing slash)
VITE_API_URL=http://localhost:8000

# Reverb (WebSocket) connection — must match the backend .env REVERB_* values.
# Leave VITE_REVERB_APP_KEY empty to disable sockets and fall back to polling.
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
